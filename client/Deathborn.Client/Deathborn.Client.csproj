<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Deathborn.Client</RootNamespace>
    <AssemblyName>Deathborn.Client</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <!-- Debug: no apphost.exe — dev-all rebuilds while clients run via `dotnet exec` DLL only. -->
    <UseAppHost Condition="'$(Configuration)' == 'Debug'">false</UseAppHost>
    <!-- MonoGame needs a full process restart; hot reload cannot patch the game loop. -->
    <!-- Debug dev builds: hide known benign compiler warnings in task dev:all / hot reload output. -->
    <NoWarn Condition="'$(Configuration)' == 'Debug'">$(NoWarn);CS9124;CS0649</NoWarn>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <!-- Copies MonoGame.Extended.Content.Pipeline.dll for MGCB Editor references. -->
    <MonoGameExtendedPipelineReferencePath>$(MSBuildThisFileDirectory)pipeline-references</MonoGameExtendedPipelineReferencePath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <Watch Include="Content\**\*.mgcb" />
    <Watch Include="Content\**\*.png" />
    <Watch Include="Content\**\*.jpg" />
    <Watch Include="Content\**\*.mp3" />
    <Watch Include="Content\**\*.ogg" />
    <Watch Include="Content\**\*.wav" />
    <Watch Include="Content\**\*.spritefont" />
    <Watch Include="Content\**\*.tmx" />
    <Watch Include="Content\**\*.tsx" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\shared\world\realik_collision.bin" Link="Content\World\realik_collision.bin" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\shared\world\realik_elevation.bin" Link="Content\World\realik_elevation.bin" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\Maps\manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\Maps\**\*.tmx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Content\Maps\**\*.tsx" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\shared\protocol.json" Link="Protocol\protocol.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Extended" Version="6.0.1" />
    <PackageReference Include="MonoGame.Extended.Content.Pipeline" Version="6.0.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.2.1105" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
</Project>
