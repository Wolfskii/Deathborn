# Copy to .env and adjust as needed.

# Postgres connection string used by the Go server.
# When running the server locally (outside Docker) use localhost.
DATABASE_URL=postgres://deathborn:deathborn@localhost:5432/deathborn?sslmode=disable

# Secret used to sign/verify JWTs. CHANGE THIS in any real deployment.
JWT_SECRET=dev-secret-change-me

# HTTP/WebSocket port the server listens on.
PORT=8080
