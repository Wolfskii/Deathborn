# Copy to `.env` and adjust. Used by `docker compose` and local `task dev:server`.
#
# ── Dokploy deployment (Postgres 18 managed separately) ─────────────────────
#
# 1. In Dokploy, create a PostgreSQL 18 database (note the values below).
# 2. Create a Docker Compose application pointing at this repo's `docker-compose.yml`.
# 3. Open the compose app → Environment tab (not the shared project Environment).
#    Paste ONLY key=value lines below — no comments (Dokploy's .env parser may skip them).
# 4. Deploy — only the `server` service runs; migrations apply on startup.
#
# Shared project Environment variables (${{environment.VAR}}) are a separate layer.
# For compose, either put values in this compose app's Environment tab, or on the
# server service set: DATABASE_URL=${{environment.DATABASE_URL}} etc.
#
# If Postgres is a Dokploy database in the same project, copy the **Internal Host**
# from the database's Connection tab (not the display name). Example:
#   DATABASE_URL=postgres://user:SECRET@deathborn-gamedb-v2grpe:5432/mydb?sslmode=disable
# The server compose service must be on `dokploy-network` (see docker-compose.yml).
#
# If Dokploy gives you a public URL with TLS, use sslmode=require (or verify-full):
#   DATABASE_URL=postgres://deathborn:SECRET@db.example.com:5432/deathborn?sslmode=require

# ── Required (server) ───────────────────────────────────────────────────────

# Full Postgres connection string (required for Dokploy / external Postgres).
# Local Docker Compose (`--profile local`): use host `db`, not `localhost`:
#   DATABASE_URL=postgres://deathborn:change-me@db:5432/deathborn?sslmode=disable
# Local `task dev:server` on host: use `localhost`:
#   DATABASE_URL=postgres://deathborn:change-me@localhost:5432/deathborn?sslmode=disable
DATABASE_URL=postgres://deathborn:change-me@db:5432/deathborn?sslmode=disable

# Secret for signing JWTs. Generate a long random string for production, e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-secret-change-me

# HTTP + WebSocket port inside the container (Dokploy reverse proxy should target this).
PORT=8080

# ── Postgres (local `docker compose --profile local` only) ──────────────────
# These are used by the bundled `db` service. Not needed when Postgres runs on Dokploy.

POSTGRES_USER=deathborn
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deathborn
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Convenience — same as DATABASE_URL when using the local profile:
# DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# ── Optional ────────────────────────────────────────────────────────────────

# Docker image tag / build version label (compose build arg).
VERSION=dev

# Bind address. Leave empty in Docker/Dokploy (listens on all interfaces).
# Set to 127.0.0.1 only for local `go run` / `task dev:server` on Windows.
LISTEN_HOST=

# ── Client (MonoGame — not used by the server container) ────────────────────

# Override API URL in the game client (optional).
# DEATHBORN_SERVER_URL=https://api.your-domain.example
